# ron-kimi-dasboard — mac-agent configuration (copy to config.env, chmod 600)
# config.env is gitignored and must NEVER be committed. All values are plain KEY=VALUE.

RELAY_TOKEN=            # dashboard passphrase = code-server password; setup.sh offers a generated 24-char default (REQUIRED)
GITHUB_PAT=             # fine-grained PAT: repo access = only wrcron2/ron-kimi-dasboard, permission Contents: Read and write (REQUIRED for live status)
REPO_OWNER=wrcron2      # GitHub repo owner
REPO_NAME=ron-kimi-dasboard  # GitHub repo name
LIVE_BRANCH=live        # branch heartbeat.js publishes link.json to (never the Pages branch)
GROQ_API_KEY=           # optional free cloud chat fallback key from console.groq.com (empty = groq backend unavailable)
GROQ_MODEL=openai/gpt-oss-120b  # Groq model (verified free tier: 30 RPM / 1K RPD)
KIMI_BIN=kimi           # kimi CLI binary name or absolute path override if not on PATH
CODE_SERVER_PORT=8080   # code-server bind port (always 127.0.0.1 only)
RELAY_PORT=8790         # relay bind port (always 127.0.0.1 only)
CLAW_PORT=              # optional OpenClaw Control UI port, e.g. 18789; empty = claw disabled
CLAW_TOKEN=             # optional OpenClaw gateway token (enables ?token= deep-link login in openUrl)
WORKSPACE_DIR=~/Documents/Claude/Projects  # code-server workspace folder (created if missing)
